import { Theme } from "theme.slint";
import { KeyRow, ThemeCard, HighlightRow, LibraryRow } from "structs.slint";
import { Toggle, Select, Segmented, Button, QuietButton, Field, Icon, Kbd, Label } from "widgets.slint";

component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    callback clicked();

    height: 34px;
    border-radius: Theme.radius;
    background: root.active ? Theme.raised : touch.has-hover ? Theme.hover : transparent;

    Icon {
        x: 12px;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        color: root.active || touch.has-hover ? Theme.text : Theme.text-muted;
    }
    Text {
        x: 36px;
        width: parent.width - 48px;
        text: root.text;
        color: root.active || touch.has-hover ? Theme.text : Theme.text-muted;
        font-size: Theme.font-size;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A group of settings under a small heading.
component Group inherits VerticalLayout {
    in property <string> title;

    Label {
        height: 28px;
        vertical-alignment: top;
        label: root.title;
    }
    @children
}

// One setting: title and description on the left, a control on the right,
// ruled off from the one above.
component Row inherits Rectangle {
    in property <string> title;
    in property <string> description;

    min-height: 52px;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-top: 9px;
        padding-bottom: 8px;
        spacing: 24px;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-size;
                wrap: word-wrap;
            }
            if root.description != "": Text {
                text: root.description;
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;

            @children
        }
    }
}

// A theme, previewed as the window it makes: header, accent, and a lit
// page with a highlight.
component ThemePreview inherits Rectangle {
    in property <ThemeCard> theme;
    in property <bool> current;
    callback picked();

    VerticalLayout {
        spacing: 8px;

        Rectangle {
            height: 112px;
            border-radius: Theme.radius + 2px;
            background: root.theme.background;
            clip: true;

            Rectangle {
                y: 0;
                height: 14px;
                background: root.theme.surface;
            }
            Rectangle {
                x: 0;
                y: 14px;
                width: parent.width * 0.46;
                height: 1px;
                background: root.theme.accent;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 26px;
                width: 92px;
                height: 100px;
                background: root.theme.page;

                for line[i] in [0.6, 1, 1, 1, 0.8]: Rectangle {
                    x: 10px;
                    y: 12px + i * 8px;
                    width: (parent.width - 20px) * line;
                    height: 2px;
                    background: i == 3 ? root.theme.highlight : root.theme.ink;
                    opacity: i == 3 ? 1 : 0.55;
                }
            }
            // Drawn last, over the clipped corners.
            Rectangle {
                border-radius: Theme.radius + 2px;
                border-width: root.current ? 2px : 1px;
                border-color: root.current ? Theme.accent : touch.has-hover ? Theme.text-muted : root.theme.border;
            }
        }

        HorizontalLayout {
            spacing: 6px;

            if root.current: Icon {
                y: (parent.height - self.height) / 2;
                name: "check";
                color: Theme.accent;
            }
            Text {
                text: root.theme.name;
                color: Theme.text;
                font-size: Theme.font-size;
                vertical-alignment: center;
            }
            Text {
                text: root.theme.detail == "" ? "" : "· " + root.theme.detail;
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.picked();
        }
    }
}

export component SettingsView inherits Rectangle {
    // "general", "reading", "appearance" (or "theme", shown with it),
    // "keys", "files", or "about".
    in-out property <string> section: "general";
    // The house themes, previewed; the rest are listed by name.
    in property <[ThemeCard]> theme-cards;
    in property <[string]> other-themes;
    // The current theme when it is one of the rest, else a prompt.
    in property <string> other-theme;
    in property <string> theme;
    // "original", "paper", or "inverted".
    in property <string> page-colors;
    in property <[string]> font-options;
    in property <string> font-name;
    in property <int> font-size;
    // "Compact", "Comfortable", or "Spacious".
    in property <string> density;
    // "Sharp", "Rounded", or "Round".
    in property <string> corners;
    // "Small", "Medium", or "Large".
    in property <string> thumbnail-size;
    // "Fit width" or "Fit page".
    in property <string> default-zoom;
    in property <bool> restore-session;
    in property <bool> sidebar;
    in property <bool> vim;
    in property <bool> study-timer;
    in property <[KeyRow]> keys;
    in property <string> language;
    in property <[string]> language-options;
    in property <[HighlightRow]> highlights;
    in property <[color]> presets;
    in property <string> data-dir;
    in property <string> problems;
    in property <string> version;
    // Which sections match the search box.
    in property <bool> show-general: true;
    in property <bool> show-reading: true;
    in property <bool> show-theme: true;
    in property <bool> show-appearance: true;
    in property <bool> show-keys: true;
    in property <bool> show-files: true;
    in property <bool> show-libraries: true;
    in property <[LibraryRow]> library-rows;
    in property <[string]> library-icons;
    in property <[string]> library-icon-keys;
    in-out property <int> library-selected;
    in-out property <string> query <=> search.text;
    // key/value pairs, or commands with an empty value.
    callback set(string, string);
    callback searched(string);
    callback close();

    property <bool> appearance: root.section == "appearance" || root.section == "theme";

    background: Theme.background;

    HorizontalLayout {
        // Navigation.
        Rectangle {
            width: 240px;
            background: Theme.surface;

            VerticalLayout {
                padding: 12px;
                padding-top: 16px;
                padding-bottom: 16px;
                spacing: 2px;

                // Search.
                Rectangle {
                    height: 34px;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: search.has-focus ? Theme.accent : Theme.border;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;

                        Icon {
                            y: (parent.height - self.height) / 2;
                            name: "search";
                        }
                        search := Field {
                            horizontal-stretch: 1;
                            font-size: Theme.font-size-ui;
                            edited => {
                                root.searched(self.text);
                            }
                        }
                    }

                    if search.text == "": Text {
                        x: 32px;
                        width: parent.width - 40px;
                        text: @tr("Search settings");
                        color: Theme.text-muted;
                        font-size: Theme.font-size-ui;
                        overflow: elide;
                    }
                }
                Rectangle {
                    height: 10px;
                }

                if root.show-general: NavItem {
                    text: @tr("General");
                    icon: "general";
                    active: root.section == "general";
                    clicked => {
                        root.section = "general";
                    }
                }
                if root.show-reading: NavItem {
                    text: @tr("Reading and study");
                    icon: "reading";
                    active: root.section == "reading";
                    clicked => {
                        root.section = "reading";
                    }
                }
                if root.show-theme || root.show-appearance: NavItem {
                    text: @tr("Appearance");
                    icon: "appearance";
                    active: root.appearance;
                    clicked => {
                        root.section = "appearance";
                    }
                }
                if root.show-keys: NavItem {
                    text: @tr("Keys");
                    icon: "keys";
                    active: root.section == "keys";
                    clicked => {
                        root.section = "keys";
                    }
                }
                if root.show-libraries: NavItem {
                    text: @tr("Libraries");
                    icon: "book";
                    active: root.section == "libraries";
                    clicked => {
                        root.section = "libraries";
                    }
                }
                if root.show-files: NavItem {
                    text: @tr("Files");
                    icon: "file";
                    active: root.section == "files";
                    clicked => {
                        root.section = "files";
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                NavItem {
                    text: @tr("About Leme");
                    icon: "about";
                    active: root.section == "about";
                    clicked => {
                        root.section = "about";
                    }
                }
            }

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.border;
            }
        }

        VerticalLayout {
            Flickable {
                vertical-stretch: 1;
                content-width: self.width;
                content-height: body.preferred-height;

                body := VerticalLayout {
                    width: min(parent.width, 872px);
                    padding-left: 48px;
                    padding-right: 48px;
                    padding-top: 32px;
                    padding-bottom: 32px;
                    spacing: 28px;
                    alignment: start;

                    HorizontalLayout {
                        Text {
                            text: root.section == "general" ? @tr("General") : root.section == "reading" ? @tr("Reading and study") : root.appearance ? @tr("Appearance") : root.section == "keys" ? @tr("Keys") : root.section == "files" ? @tr("Files") : root.section == "libraries" ? @tr("Libraries") : @tr("About Leme");
                            color: Theme.text;
                            font-size: Theme.font-size-title;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        QuietButton {
                            y: (parent.height - self.height) / 2;
                            text: @tr("Restore defaults");
                            clicked => {
                                root.set("reset", "");
                            }
                        }
                    }

                    if root.problems != "": Rectangle {
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.accent;
                        height: problem-text.preferred-height + 20px;

                        problem-text := Text {
                            x: 12px;
                            width: parent.width - 24px;
                            text: root.problems;
                            color: Theme.text;
                            font-size: Theme.font-size-small;
                            wrap: word-wrap;
                        }
                    }

                    if root.section == "general": Group {
                        title: @tr("Language");

                        Row {
                            title: @tr("Interface language");
                            description: @tr("Menus, messages, and exports.");
                            Select {
                                options: root.language-options;
                                value: root.language;
                                selected(value) => {
                                    root.set("language", value);
                                }
                            }
                        }
                    }
                    if root.section == "general": Group {
                        title: @tr("Session");

                        Row {
                            title: @tr("Reattach on startup");
                            description: @tr("Reopen the last session's document at the page and zoom you left it, like tmux attach.");
                            Toggle {
                                checked: root.restore-session;
                                toggled => {
                                    root.set("restore-session", root.restore-session ? "false" : "true");
                                }
                            }
                        }
                    }

                    if root.section == "reading": Group {
                        title: @tr("Layout");

                        Row {
                            title: @tr("Default zoom");
                            description: @tr("For documents you haven't opened before.");
                            Segmented {
                                options: [{ id: "Fit width", label: @tr("Fit width") }, { id: "Fit page", label: @tr("Fit page") }];
                                value: root.default-zoom;
                                selected(value) => {
                                    root.set("default-zoom", value);
                                }
                            }
                        }
                        Row {
                            title: @tr("Side panel");
                            description: @tr("Show pages, outline, or notes next to the document.");
                            Toggle {
                                checked: root.sidebar;
                                toggled => {
                                    root.set("sidebar", root.sidebar ? "false" : "true");
                                }
                            }
                        }
                    }
                    if root.section == "reading": Group {
                        title: @tr("Highlights");

                        Text {
                            text: @tr("What each color means, shown in the notes panel and in exports. Keys 1–5 pick them in this order.");
                            color: Theme.text-muted;
                            font-size: Theme.font-size-small;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 10px;
                        }
                        for h[i] in root.highlights: Rectangle {
                            height: highlight-row.preferred-height;

                            highlight-row := VerticalLayout {
                                padding-left: 0px;
                                padding-right: 0px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 8px;

                                HorizontalLayout {
                                    spacing: 12px;

                                    Text {
                                        text: "";
                                        width: 0px;
                                    }
                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 11px;
                                        background: h.color;

                                        Text {
                                            text: i + 1;
                                            color: Theme.ink;
                                            font-size: Theme.font-size-label;
                                            font-weight: 600;
                                        }
                                    }
                                    // Name: saved on Enter or when leaving the field.
                                    Rectangle {
                                        height: 30px;
                                        horizontal-stretch: 1;
                                        border-radius: Theme.radius;
                                        border-width: 1px;
                                        border-color: name-input.has-focus ? Theme.accent : Theme.border;

                                        name-input := Field {
                                            x: 10px;
                                            width: parent.width - 20px;
                                            text: h.name;
                                            accepted => {
                                                root.set("color-name", h.key + "=" + self.text);
                                            }
                                            changed has-focus => {
                                                if !self.has-focus && self.text != h.name {
                                                    root.set("color-name", h.key + "=" + self.text);
                                                }
                                            }
                                        }
                                    }
                                    // Shade as hex.
                                    Rectangle {
                                        height: 30px;
                                        width: 90px;
                                        border-radius: Theme.radius;
                                        border-width: 1px;
                                        border-color: hex-input.has-focus ? Theme.accent : Theme.border;

                                        hex-input := Field {
                                            x: 10px;
                                            width: parent.width - 20px;
                                            text: h.hex;
                                                                                        font-size: Theme.font-size-small;
                                            accepted => {
                                                root.set("color-hex", h.key + "=" + self.text);
                                            }
                                            changed has-focus => {
                                                if !self.has-focus && self.text != h.hex {
                                                    root.set("color-hex", h.key + "=" + self.text);
                                                }
                                            }
                                        }
                                    }
                                }

                                // Preset shades.
                                HorizontalLayout {
                                    padding-left: 34px;
                                    spacing: 6px;
                                    alignment: start;

                                    for p[pi] in root.presets: Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 8px;
                                        background: p;
                                        border-width: preset-touch.has-hover || p == h.color ? 2px : 0;
                                        border-color: Theme.text;

                                        preset-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.set("color-hex", h.key + "=preset:" + pi);
                                            }
                                        }
                                    }
                                    QuietButton {
                                        height: 20px;
                                        text: @tr("Default");
                                        font-size: Theme.font-size-small;
                                        clicked => {
                                            root.set("color-hex", h.key + "=reset");
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                y: 0;
                                height: 1px;
                                background: Theme.border;
                            }
                        }
                    }
                    if root.section == "reading": Group {
                        title: @tr("Study");

                        Row {
                            title: @tr("Study timer");
                            description: @tr("Shows today's reading time in the header and keeps it per day and document. Off, nothing is counted or shown.");
                            Toggle {
                                checked: root.study-timer;
                                toggled => {
                                    root.set("study-timer", root.study-timer ? "false" : "true");
                                }
                            }
                        }
                    }
                    if root.section == "reading": Group {
                        title: @tr("Keyboard");

                        Row {
                            title: @tr("Vim keys");
                            description: @tr("j/k scroll, gg/G first/last page, Ctrl+D/U half screen, / search, n/N matches, : command palette, y copy.");
                            Toggle {
                                checked: root.vim;
                                toggled => {
                                    root.set("vim", root.vim ? "false" : "true");
                                }
                            }
                        }
                    }

                    if root.appearance: VerticalLayout {
                        spacing: 12px;

                        Label {
                            label: @tr("Theme");
                        }
                        HorizontalLayout {
                            spacing: 16px;

                            for card in root.theme-cards: ThemePreview {
                                horizontal-stretch: 1;
                                theme: card;
                                current: card.name == root.theme;
                                picked => {
                                    root.set("theme", card.name);
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;

                            Text {
                                text: @tr("{} more themes, built in and yours, as .toml files.", root.other-themes.length);
                                color: Theme.text-muted;
                                font-size: Theme.font-size-ui;
                                vertical-alignment: center;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                            Select {
                                options: root.other-themes;
                                value: root.other-theme;
                                selected(value) => {
                                    root.set("theme", value);
                                }
                            }
                            Button {
                                text: @tr("Open folder");
                                clicked => {
                                    root.set("open-themes", "");
                                }
                            }
                        }
                    }
                    if root.appearance: Group {
                        title: @tr("Pages");

                        Row {
                            title: @tr("Page colors");
                            description: @tr("Paper tints the PDF's white with the theme's page color, so it doesn't glare at night.");
                            Segmented {
                                options: [{ id: "original", label: @tr("Original") }, { id: "paper", label: @tr("Paper") }, { id: "inverted", label: @tr("Inverted") }];
                                value: root.page-colors;
                                selected(value) => {
                                    root.set("page-colors", value);
                                }
                            }
                        }
                    }
                    if root.appearance: Group {
                        title: @tr("Interface");

                        Row {
                            title: @tr("Font");
                            description: @tr("Any installed font also works in config.toml.");
                            Select {
                                options: root.font-options;
                                value: root.font-name;
                                selected(value) => {
                                    root.set("font", value);
                                }
                            }
                        }
                        Row {
                            title: @tr("Text size");
                            description: @tr("Menus, panels, and the palette.");
                            Segmented {
                                options: [{ id: "13", label: "13" }, { id: "14", label: "14" }, { id: "15", label: "15" }, { id: "16", label: "16" }];
                                value: "\{root.font-size}";
                                selected(value) => {
                                    root.set("font-size", value);
                                }
                            }
                        }
                        Row {
                            title: @tr("Density");
                            description: @tr("Spacing and header height.");
                            Segmented {
                                options: [{ id: "Compact", label: @tr("Compact") }, { id: "Comfortable", label: @tr("Normal") }, { id: "Spacious", label: @tr("Spacious") }];
                                value: root.density;
                                selected(value) => {
                                    root.set("density", value);
                                }
                            }
                        }
                        Row {
                            title: @tr("Corners");
                            Segmented {
                                options: [{ id: "Sharp", label: @tr("Sharp") }, { id: "Rounded", label: @tr("Rounded") }, { id: "Round", label: @tr("Round") }];
                                value: root.corners;
                                selected(value) => {
                                    root.set("corners", value);
                                }
                            }
                        }
                        Row {
                            title: @tr("Thumbnail size");
                            Segmented {
                                options: [{ id: "Small", label: @tr("Small") }, { id: "Medium", label: @tr("Medium") }, { id: "Large", label: @tr("Large") }];
                                value: root.thumbnail-size;
                                selected(value) => {
                                    root.set("thumbnail-size", value);
                                }
                            }
                        }
                    }

                    if root.section == "keys": VerticalLayout {
                        Text {
                            text: @tr("Rebind any action under [keys] using the name on the right, e.g.  zoom-in = [\"ctrl+=\", \"z i\"]. An empty list unbinds it.");
                            color: Theme.text-muted;
                            font-size: Theme.font-size-small;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 16px;
                        }
                        for row[i] in root.keys: Rectangle {
                            height: 36px;

                            Rectangle {
                                y: 0;
                                height: 1px;
                                background: Theme.border;
                            }

                            HorizontalLayout {
                                spacing: Theme.spacing;

                                Text {
                                    text: row.title;
                                    color: Theme.text;
                                    font-size: Theme.font-size-ui;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: row.keys != "" ? row.keys : "—";
                                    color: row.keys != "" ? Theme.text : Theme.text-muted;
                                    font-size: Theme.font-size-small;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                                Text {
                                    width: 170px;
                                    text: row.name;
                                    color: Theme.text-muted;
                                    font-size: Theme.font-size-small;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    if root.section == "libraries": VerticalLayout {
                        spacing: 24px;

                        Text {
                            text: @tr("Libraries keep documents for every session: saved pages and PDFs. Laws saved from planalto.gov.br go into Leis on their own.");
                            color: Theme.text-muted;
                            font-size: Theme.font-size-small;
                            wrap: word-wrap;
                        }

                        // Every library as a card, then one to make a new one.
                        Rectangle {
                            property <length> card: 132px;
                            property <length> gap: 14px;
                            property <int> columns: max(1, floor((self.width + self.gap) / (self.card + self.gap)));
                            height: ceil((root.library-rows.length + 1) / self.columns) * (self.card + 46px + self.gap);

                            for library[i] in root.library-rows: Rectangle {
                                x: mod(i, parent.columns) * (parent.card + parent.gap);
                                y: floor(i / parent.columns) * (parent.card + 46px + parent.gap);
                                width: parent.card;
                                height: parent.card + 46px;

                                card-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.library-selected = i;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 8px;

                                    Rectangle {
                                        height: parent.width;
                                        border-radius: Theme.radius + 4px;
                                        border-width: root.library-selected == i ? 2px : 1px;
                                        border-color: root.library-selected == i ? Theme.accent : card-touch.has-hover ? Theme.text-muted : Theme.border;
                                        background: Theme.surface;
                                        clip: true;

                                        if library.has-image: Image {
                                            width: parent.width;
                                            height: parent.height;
                                            source: library.image;
                                            image-fit: cover;
                                        }
                                        if !library.has-image: Icon {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            width: 46px;
                                            height: 46px;
                                            name: library.icon;
                                            color: Theme.accent;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 1px;

                                        Text {
                                            text: library.name;
                                            color: Theme.text;
                                            font-size: Theme.font-size;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: library.count;
                                            color: Theme.text-muted;
                                            font-size: Theme.font-size-small;
                                        }
                                    }
                                }
                            }

                            // New library: type its name on the card.
                            Rectangle {
                                x: mod(root.library-rows.length, parent.columns) * (parent.card + parent.gap);
                                y: floor(root.library-rows.length / parent.columns) * (parent.card + 46px + parent.gap);
                                width: parent.card;
                                height: parent.card;
                                border-radius: Theme.radius + 4px;
                                border-width: 1px;
                                border-color: new-name.has-focus ? Theme.accent : Theme.border;
                                background: new-touch.has-hover && !new-name.has-focus ? Theme.hover : transparent;

                                new-touch := TouchArea {
                                    mouse-cursor: text;
                                    clicked => {
                                        new-name.focus();
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 10px;
                                    padding: 12px;

                                    HorizontalLayout {
                                        alignment: center;

                                        Icon {
                                            width: 20px;
                                            height: 20px;
                                            name: "plus";
                                        }
                                    }
                                    Rectangle {
                                        height: 22px;

                                        new-name := Field {
                                            width: parent.width;
                                            font-size: Theme.font-size-small;
                                            horizontal-alignment: center;
                                            accepted => {
                                                root.set("library-new", self.text);
                                                self.text = "";
                                            }
                                        }
                                        if new-name.text == "": Text {
                                            width: parent.width;
                                            text: new-name.has-focus ? @tr("Name, then Enter") : @tr("New library");
                                            color: Theme.text-muted;
                                            font-size: Theme.font-size-small;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            height: parent.height;
                                        }
                                    }
                                }
                            }
                        }

                        // The chosen library.
                        for library[i] in root.library-rows: Group {
                            visible: i == root.library-selected;
                            height: i == root.library-selected ? self.preferred-height : 0;
                            title: library.name;

                            Row {
                                title: @tr("Name");
                                description: library.count;
                                Rectangle {
                                    width: 220px;
                                    height: 30px;
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: rename.has-focus ? Theme.accent : Theme.border;

                                    rename := Field {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        text: library.name;
                                        font-size: Theme.font-size-ui;
                                        accepted => {
                                            root.set("library-rename", "\{i}\n\{self.text}");
                                        }
                                        changed has-focus => {
                                            if !self.has-focus && self.text != library.name {
                                                root.set("library-rename", "\{i}\n\{self.text}");
                                            }
                                        }
                                    }
                                }
                            }
                            Row {
                                title: @tr("Icon");
                                description: library.has-image ? @tr("Your picture is shown instead of the icon.") : "";
                                HorizontalLayout {
                                    spacing: 2px;

                                    for key in root.library-icon-keys: QuietButton {
                                        icon: key;
                                        icon-size: 16px;
                                        selected: !library.has-image && library.icon == key;
                                        clicked => {
                                            root.set("library-icon", "\{i}\n\{key}");
                                        }
                                    }
                                }
                            }
                            Row {
                                title: @tr("Picture");
                                description: @tr("PNG, JPG, SVG, or WebP, shown on the card and the home screen.");
                                Button {
                                    text: library.has-image ? @tr("Remove picture") : @tr("Picture…");
                                    clicked => {
                                        root.set(library.has-image ? "library-clear-picture" : "library-picture", "\{i}");
                                    }
                                }
                            }
                            for doc[j] in library.documents: Row {
                                title: doc;
                                QuietButton {
                                    icon: "close";
                                    tip: @tr("Remove from the library (the file stays)");
                                    clicked => {
                                        root.set("library-remove-doc", "\{i}\n\{j}");
                                    }
                                }
                            }
                            Row {
                                title: @tr("Delete library");
                                description: @tr("Its documents stay where they are.");
                                Button {
                                    text: @tr("Delete");
                                    clicked => {
                                        root.set("library-delete", "\{i}");
                                        root.library-selected = max(0, i - 1);
                                    }
                                }
                            }
                        }
                    }

                    if root.section == "files": Group {
                        title: @tr("Configuration files");

                        Row {
                            title: "config.toml";
                            description: @tr("Every setting here, plus keybindings. Changes made in this window are written there too.");
                            HorizontalLayout {
                                spacing: 6px;

                                Button {
                                    text: @tr("Open");
                                    clicked => {
                                        root.set("open-config", "");
                                    }
                                }
                                Button {
                                    text: @tr("Reload");
                                    clicked => {
                                        root.set("reload", "");
                                    }
                                }
                            }
                        }
                        Row {
                            title: @tr("Themes");
                            description: @tr("Add .toml files to the themes folder.");
                            HorizontalLayout {
                                spacing: 6px;

                                Button {
                                    text: @tr("Open folder");
                                    clicked => {
                                        root.set("open-themes", "");
                                    }
                                }
                                Button {
                                    text: @tr("Reload");
                                    clicked => {
                                        root.set("reload", "");
                                    }
                                }
                            }
                        }
                        Row {
                            title: @tr("Data folder");
                            description: root.data-dir + @tr("\nconfig.toml, themes, annotations, and reading history.");
                            Button {
                                text: @tr("Open");
                                clicked => {
                                    root.set("open-data-dir", "");
                                }
                            }
                        }
                    }

                    if root.section == "about": Group {
                        title: "Leme \{root.version}";

                        Row {
                            title: @tr("A fast, minimal, local-first PDF reader");
                            description: @tr("Built with Rust, Slint, and PDFium. MIT licensed.");
                        }
                        Row {
                            title: @tr("Private by design");
                            description: @tr("No telemetry, no accounts, no network access. Your notes, settings, and history stay in the data folder.");
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                padding-top: 12px;
                padding-bottom: 12px;
                padding-left: 48px;
                padding-right: 48px;
                spacing: 10px;

                Text {
                    text: @tr("Everything here is saved to config.toml. Nothing leaves this machine.");
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                Button {
                    y: (parent.height - self.height) / 2;
                    text: @tr("Open config.toml");
                    clicked => {
                        root.set("open-config", "");
                    }
                }
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: close-hint.preferred-width;
                    height: 28px;
                    border-radius: Theme.radius;
                    background: close-touch.has-hover ? Theme.hover : transparent;

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.close();
                        }
                    }

                    close-hint := HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 6px;

                        Kbd {
                            y: (parent.height - self.height) / 2;
                            text: "Esc";
                        }
                        Text {
                            text: @tr("close");
                            color: Theme.text-muted;
                            font-size: Theme.font-size-small;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
