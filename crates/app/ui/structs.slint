// Data passed from Rust to the UI.

// A search match, as fractions of its page.
export struct Highlight {
    x: float,
    y: float,
    width: float,
    height: float,
    current: bool,
}

// One rect of an annotation or the selection, as fractions of its page.
// kind: 0 highlight, 1 underline, 2 strikethrough, 3 selection.
export struct Mark {
    x: float,
    y: float,
    width: float,
    height: float,
    kind: int,
    color: color,
    // Draw a note marker at this rect's end.
    note: bool,
}

export struct PageView {
    x: length,
    y: length,
    width: length,
    height: length,
    image: image,
    loaded: bool,
    highlights: [Highlight],
    marks: [Mark],
}

export struct ThumbView {
    page: int,
    x: length,
    y: length,
    width: length,
    height: length,
    image: image,
    loaded: bool,
    // Colors of the page's annotations, at most three.
    dots: [color],
}

// A row of the outline or notes panel. In the outline, `title` is the
// section; in the notes, it is the highlight color's name.
export struct SideItem {
    title: string,
    depth: int,
    color: color,
    current: bool,
    // Outline progress: -1 no marker, 0 unread, 1 read, 2 and 3 reviewed.
    status: int,
    // Notes: the outline section, on the first note of each; the page,
    // the highlighted text, and the note written about it.
    header: string,
    page: string,
    quote: string,
    note: string,
}

// A highlight color in Settings: its key in annotation files, the name
// the user gave it, and its shade.
export struct HighlightRow {
    key: string,
    name: string,
    color: color,
    hex: string,
}

// A highlight color in the notes filter.
export struct NoteFilter {
    name: string,
    color: color,
    count: int,
    on: bool,
}

// A library on the home screen: its icon, or the user's picture.
export struct LibraryItem {
    name: string,
    icon: string,
    image: image,
    has-image: bool,
    count: string,
}

// A library in Settings, with its documents' names.
export struct LibraryRow {
    name: string,
    icon: string,
    icon-title: string,
    image: image,
    has-image: bool,
    count: string,
    documents: [string],
}

// A document card in a library: its first page as cover, and progress.
export struct BookCard {
    title: string,
    detail: string,
    percent: string,
    progress: float,
    has-progress: bool,
    cover: image,
    has-cover: bool,
}

export struct RecentItem {
    title: string,
    folder: string,
}

// A document of the current session, on the home screen.
export struct SubjectItem {
    title: string,
    detail: string,
    progress: float,
    has-progress: bool,
    active: bool,
}

export struct TabItem {
    title: string,
    active: bool,
}

export struct PaletteItem {
    title: string,
    detail: string,
    keys: string,
    // Group name, on the first item of each group.
    header: string,
    // Themes show their background, page, and accent.
    swatch: bool,
    color1: color,
    color2: color,
    color3: color,
}

// A row of the session search: a document's name and match count
// (`header`), or one page with a match.
export struct SearchHit {
    header: bool,
    title: string,
    page: string,
    current: bool,
}

export struct KeyRow {
    title: string,
    name: string,
    keys: string,
}

// A theme as previewed in Settings: the window, its header, the accent,
// and a page with a few lines of text and a highlight.
export struct ThemeCard {
    name: string,
    detail: string,
    background: color,
    surface: color,
    border: color,
    accent: color,
    page: color,
    ink: color,
    highlight: color,
}
