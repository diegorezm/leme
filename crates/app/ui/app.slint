import { Theme } from "theme.slint";
import { PageView, ThumbView, RecentItem, TabItem, PaletteItem, KeyRow, ThemeCard, SideItem, NoteFilter, SubjectItem, HighlightRow, SearchHit, LibraryItem, LibraryRow, BookCard } from "structs.slint";
import { Panel, Scrim, Field, QuietButton, Chip, Icon, Kbd, Label, Toggle, Button } from "widgets.slint";
import { Sidebar, ReadingArea, StartScreen, TabBar, LibraryScreen } from "reader.slint";
import { Palette } from "palette.slint";
import { SettingsView } from "settings.slint";

export { Theme }
export { Highlight, Mark, PageView, ThumbView, RecentItem, TabItem, PaletteItem, KeyRow, ThemeCard, SideItem, NoteFilter, SubjectItem, HighlightRow, SearchHit, LibraryItem, LibraryRow, BookCard } from "structs.slint";

// One line of the zoom menu.
component MenuRow inherits Rectangle {
    in property <string> text;
    in property <string> keys;
    in property <bool> checked;
    callback clicked();

    height: 32px;
    border-radius: max(0px, Theme.radius - 1px);
    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        Rectangle {
            width: 14px;

            if root.checked: Icon {
                name: "check";
                color: Theme.accent;
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-size-ui;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.keys != "": Kbd {
            y: (parent.height - self.height) / 2;
            text: root.keys;
        }
    }
}

// A highlight pigment with its key inside, so it never depends on hue alone.
component Pigment inherits Rectangle {
    in property <color> pigment;
    in property <int> number;
    in property <bool> chosen;
    callback clicked();

    width: 26px;
    height: 26px;

    // Ring around the chosen or hovered pigment.
    if root.chosen || touch.has-hover: Rectangle {
        width: 26px;
        height: 26px;
        border-radius: 13px;
        border-width: 1px;
        border-color: Theme.text;
    }
    Rectangle {
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: root.pigment;

        Text {
            text: root.number;
            color: Theme.ink;
            font-size: Theme.font-size-label;
            font-weight: 600;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A shortcut and what it does, in an overlay's footer.
component Hint inherits HorizontalLayout {
    in property <string> keys;
    in property <string> text;

    spacing: 6px;

    Kbd {
        y: (parent.height - self.height) / 2;
        text: root.keys;
    }
    Text {
        text: root.text;
        color: Theme.text-muted;
        font-size: Theme.font-size-small;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    title: root.page-count > 0 ? "\{root.document-title} — Leme" : "Leme";
    icon: @image-url("../../../assets/icon.svg");
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.background;
    default-font-family: Theme.font-family;

    // Chrome.
    in-out property <bool> sidebar-visible: true;
    // The side panel width the user dragged to; 0 is automatic.
    in property <length> side-panel-width;
    callback side-panel-resized(length);
    // Show the header button that opens and closes the sidebar.
    in property <bool> sidebar-button: true;
    in property <bool> fullscreen;
    in property <bool> focus-mode;
    in property <[TabItem]> tabs;
    in property <string> document-title;
    in property <int> current-page: 0;
    in property <int> page-count: 0;
    // The outline section the reader is in, shown beside the page number.
    in property <string> section-title;
    // Notification in the bottom-right corner; Rust clears it.
    in-out property <string> status;
    // Shortcuts shown next to controls: fit width, fit page, zoom out,
    // zoom in, reset zoom, palette, mark section, export notes, add note,
    // copy, search, search session, open, toggle sidebar, settings.
    in property <[string]> header-keys;
    in property <int> zoom-percent: 100;
    // "fit-width", "fit-page", or "custom".
    in property <string> zoom-mode: "fit-width";

    // Pages.
    in property <[PageView]> pages;
    in property <length> content-width;
    in property <length> content-height;
    in-out property <length> viewport-x;
    in-out property <length> viewport-y;
    out property <length> reader-width: reader.width;
    out property <length> reader-height: reader.height;

    // Thumbnails.
    in property <[ThumbView]> thumbs;
    in property <string> side-panel: "thumbs";
    in property <[SideItem]> side-items;
    in property <[NoteFilter]> note-filters;
    in property <string> notes-all-label;
    in property <string> outline-progress-text;
    in property <string> outline-reviewed-text;
    in property <float> outline-progress;
    // The current page's label (e.g. "iv") when it differs from its number.
    in property <string> page-label;
    in property <bool> prompt-secret;
    in property <length> thumbs-content-height;
    in-out property <length> thumbs-viewport-y;

    // Start screen.
    in property <[RecentItem]> recent;
    in property <[RecentItem]> sessions;
    in property <[LibraryItem]> libraries;
    callback open-library(int);
    // A library shown in place of the home screen.
    in property <bool> library-view;
    in property <string> library-name;
    in property <string> library-icon;
    in property <image> library-image;
    in property <bool> library-has-image;
    in property <string> library-summary;
    in property <[BookCard]> library-books;
    in property <int> library-hero: -1;
    in-out property <string> library-query;
    callback library-action(string, int);
    callback library-searched(string);
    in property <string> session-name: "main";
    in property <bool> home: true;
    in property <[SubjectItem]> subjects;
    in property <string> study-summary;
    in property <string> greeting;

    // Study time today, shown in the header while `study-timer` is on.
    in property <bool> study-timer;
    in property <bool> study-paused;
    in property <string> study-time: "0m";

    // Overlays: "", "search", "goto", "palette", "prompt", "note",
    // "export", or "update".
    in property <string> prompt-label;
    in-out property <string> prompt-text <=> prompt-input.text;
    in property <string> overlay;
    in-out property <string> search-text <=> search-input.text;
    in property <string> search-status;
    // "document" or "session" (every tab).
    in property <string> search-scope: "document";
    in property <[SearchHit]> search-hits;
    in-out property <string> goto-text <=> goto-input.text;
    in property <[PaletteItem]> palette-items;
    in property <int> palette-selected;
    in-out property <string> palette-query <=> palette.query;
    in property <string> palette-placeholder: @tr("Search commands, tabs, files, themes, or type a page number…");
    in-out property <string> note-text <=> note-input.text;
    in property <string> note-quote;
    // The edited annotation: its color (index and name), its page, and
    // whether it already had a note.
    in property <int> note-color;
    in property <string> note-color-name;
    in property <string> note-page;
    in property <bool> note-exists;
    // Export sheet: "markdown", "anki", or "csv".
    in property <string> export-format;
    in property <bool> export-by-section;
    in property <string> export-preview;
    in property <string> export-count;
    in property <bool> export-ready;

    // Selection / annotation popup: "", "selection", or "annotation".
    in property <string> popup;
    // A newer release and whether it can install itself (not portable).
    in property <string> update-version;
    in property <bool> update-installs;
    // "install", "skip", or "later".
    callback update-action(string);
    // The note of the annotation under the mouse, shown as a tooltip.
    in property <string> note-tip;
    in property <length> note-tip-x;
    in property <length> note-tip-y;
    in property <length> popup-x;
    in property <length> popup-y;
    in property <[color]> annotation-colors;
    in property <bool> annotation-has-note;

    // Raw key text and modifiers; Rust decides what it means.
    callback key-pressed(string, bool, bool, bool) -> bool;
    callback scrolled();
    callback resized();
    callback thumbs-scrolled();
    callback thumb-clicked(int);
    callback side-panel-clicked(string);
    callback side-item-clicked(int);
    callback side-item-status-clicked(int);
    callback note-filter-clicked(int);
    callback note-filter-all();
    callback open-recent(int);
    callback open-subject(int);
    callback open-session(int);
    callback prompt-accepted(string);
    // "open", "sessions", "new-session", "sidebar", "study-timer", "goto",
    // "palette", or "export".
    callback header-action(string);
    callback search-edited(string);
    callback search-step(bool);
    // "document" or "session".
    callback search-scope-clicked(string);
    callback search-hit-clicked(int);
    callback goto-accepted(string);
    // "in", "out", "reset", "fit-width", or "fit-page".
    callback zoom-action(string);
    callback tab-clicked(int);
    callback tab-closed(int);
    // "down", "move", or "up", in reader coordinates.
    callback reader-pointer(string, length, length);
    // "highlight" / "color" (with a color index), "underline", "strike",
    // "note", "copy", or "delete".
    callback popup-action(string, int);
    callback note-saved();
    callback note-color-clicked(int);
    callback note-deleted();
    // "format" (a format name) or "by-section" ("true" / "false").
    callback export-option(string, string);
    callback export-accepted();
    callback palette-edited(string);
    callback palette-moved(int);
    callback palette-accepted();
    callback palette-clicked(int);
    // The open overlay was dismissed with the mouse; same as Esc.
    callback overlay-dismissed();

    changed viewport-y => { root.scrolled(); }
    changed viewport-x => { root.scrolled(); }
    changed reader-width => { root.resized(); }
    changed reader-height => { root.resized(); }
    changed thumbs-viewport-y => { root.thumbs-scrolled(); }

    // Moves keyboard focus to the open overlay, or back to the reader.
    public function focus-overlay() {
        if root.overlay == "search" {
            search-input.focus();
            search-input.select-all();
        } else if root.overlay == "goto" {
            goto-input.focus();
            goto-input.select-all();
        } else if root.overlay == "palette" {
            palette.focus-input();
        } else if root.overlay == "prompt" {
            prompt-input.focus();
            prompt-input.select-all();
        } else if root.overlay == "note" {
            note-input.focus();
        } else if root.overlay == "export" {
            export-keys.focus();
        } else {
            keys.focus();
        }
    }

    property <bool> chrome: !root.focus-mode && !root.fullscreen;
    property <bool> modal: root.overlay == "palette" || root.overlay == "note" || root.overlay == "export";

    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            root.key-pressed(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt) ? accept : reject
        }

        VerticalLayout {
            if root.chrome: Rectangle {
                // Above the reader, so tooltips and the zoom menu hang over it.
                z: 1;
                height: Theme.header-height;
                background: Theme.surface;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }

                // Sized by the window, not the other way around: a full
                // header squeezes its tabs instead of widening the window.
                HorizontalLayout {
                    x: 0;
                    width: parent.width;
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;

                    if root.sidebar-button && root.page-count > 0: QuietButton {
                        y: (parent.height - self.height) / 2;
                        icon: "sidebar";
                        icon-size: 16px;
                        active: root.sidebar-visible;
                        tip: root.sidebar-visible ? @tr("Hide side panel") : @tr("Show side panel");
                        tip-keys: root.header-keys[13];
                        clicked => {
                            root.header-action("sidebar");
                        }
                    }

                    // Current session, like tmux's status line.
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 28px;
                        width: session-row.preferred-width;
                        border-radius: Theme.radius;
                        background: session-touch.has-hover ? Theme.hover : transparent;

                        session-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.header-action("sessions");
                            }
                        }

                        session-row := HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;

                            Icon {
                                y: (parent.height - self.height) / 2;
                                name: "session";
                            }
                            Text {
                                text: root.session-name;
                                color: Theme.text;
                                font-size: Theme.font-size-ui;
                                vertical-alignment: center;
                            }
                            Icon {
                                y: (parent.height - self.height) / 2;
                                name: "down";
                            }
                        }
                    }

                    Rectangle {
                        width: 2px;
                    }

                    TabBar {
                        horizontal-stretch: 0;
                        tabs: root.tabs;
                        clicked(i) => {
                            root.tab-clicked(i);
                        }
                        closed(i) => {
                            root.tab-closed(i);
                        }
                    }

                    // Open another PDF in a new tab.
                    QuietButton {
                        y: (parent.height - self.height) / 2;
                        icon: "plus";
                        tip: @tr("Add to session");
                        tip-keys: root.header-keys[12];
                        clicked => {
                            root.header-action("open");
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    if root.study-timer && root.page-count > 0: Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 28px;
                        width: timer-row.preferred-width;
                        border-radius: Theme.radius;
                        background: timer-touch.has-hover ? Theme.hover : transparent;

                        timer-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.header-action("study-timer");
                            }
                        }

                        timer-row := HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;

                            // Lit while time is counting.
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: root.study-paused ? transparent : Theme.accent;
                                border-width: root.study-paused ? 1px : 0;
                                border-color: Theme.text-muted;
                            }
                            Text {
                                text: root.study-time;
                                color: timer-touch.has-hover ? Theme.text : Theme.text-muted;
                                font-size: Theme.font-size-ui;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.page-count > 0: Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: zoom-chip.width;
                        height: 28px;

                        zoom-chip := Chip {
                            clicked => {
                                zoom-menu.show();
                            }

                            Icon {
                                y: (parent.height - self.height) / 2;
                                name: "zoom";
                            }
                            Text {
                                text: "\{root.zoom-percent}%";
                                color: Theme.text;
                                font-size: Theme.font-size-ui;
                                vertical-alignment: center;
                            }
                            Icon {
                                y: (parent.height - self.height) / 2;
                                name: "down";
                            }
                        }

                        zoom-menu := PopupWindow {
                            x: parent.width - 248px;
                            y: parent.height + 6px;
                            width: 248px;
                            close-policy: close-on-click-outside;

                            Panel {
                                border-radius: Theme.radius + 2px;

                                // Clicks between rows keep the menu open.
                                TouchArea { }

                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 1px;

                                    MenuRow {
                                        text: @tr("Fit width");
                                        keys: root.header-keys[0];
                                        checked: root.zoom-mode == "fit-width";
                                        clicked => {
                                            root.zoom-action("fit-width");
                                            zoom-menu.close();
                                        }
                                    }
                                    MenuRow {
                                        text: @tr("Fit page");
                                        keys: root.header-keys[1];
                                        checked: root.zoom-mode == "fit-page";
                                        clicked => {
                                            root.zoom-action("fit-page");
                                            zoom-menu.close();
                                        }
                                    }
                                    MenuRow {
                                        text: @tr("Actual size");
                                        keys: root.header-keys[4];
                                        checked: root.zoom-mode == "custom" && root.zoom-percent == 100;
                                        clicked => {
                                            root.zoom-action("reset");
                                            zoom-menu.close();
                                        }
                                    }
                                    Rectangle {
                                        height: 7px;

                                        Rectangle {
                                            height: 1px;
                                            background: Theme.border;
                                        }
                                    }
                                    HorizontalLayout {
                                        height: 32px;
                                        padding-left: 4px;
                                        padding-right: 4px;

                                        QuietButton {
                                            y: (parent.height - self.height) / 2;
                                            icon: "minus";
                                            keys: root.header-keys[2];
                                            clicked => {
                                                root.zoom-action("out");
                                            }
                                        }
                                        Text {
                                            text: "\{root.zoom-percent}%";
                                            color: Theme.text;
                                            font-size: Theme.font-size-ui;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        QuietButton {
                                            y: (parent.height - self.height) / 2;
                                            icon: "plus";
                                            keys: root.header-keys[3];
                                            keys-first: true;
                                            clicked => {
                                                root.zoom-action("in");
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Where you are: section, page, and how far through.
                    if root.page-count > 0: Chip {
                        y: (parent.height - self.height) / 2;
                        clicked => {
                            root.header-action("goto");
                        }

                        if root.section-title != "" && root.width >= 1100px: Text {
                            text: root.section-title;
                            color: Theme.text-muted;
                            font-size: Theme.font-size-ui;
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: 180px;
                        }
                        if root.section-title != "" && root.width >= 1100px: Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 1px;
                            height: 14px;
                            background: Theme.border;
                        }
                        Text {
                            text: root.page-label != "" ? "\{root.page-label} (\{root.current-page} / \{root.page-count})" : "\{root.current-page} / \{root.page-count}";
                            color: Theme.text;
                            font-size: Theme.font-size-ui;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 36px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: Theme.border;

                            Rectangle {
                                x: 0;
                                width: parent.width * root.current-page / max(1, root.page-count);
                                border-radius: 1.5px;
                                background: Theme.accent;
                            }
                        }
                    }

                    // Everything else lives in the palette: a search box
                    // that opens it, so it reads as the way in.
                    Chip {
                        y: (parent.height - self.height) / 2;
                        width: root.width >= 1400px ? 260px : root.width >= 820px ? 200px : self.preferred-width;
                        clicked => {
                            root.header-action("palette");
                        }

                        Icon {
                            y: (parent.height - self.height) / 2;
                            name: "search";
                        }
                        if root.width >= 820px: Text {
                            text: @tr("Search commands…");
                            color: Theme.text-muted;
                            font-size: Theme.font-size-ui;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Kbd {
                            y: (parent.height - self.height) / 2;
                            text: root.header-keys[5];
                        }
                    }
                    QuietButton {
                        y: (parent.height - self.height) / 2;
                        icon: "settings";
                        icon-size: 16px;
                        tip: @tr("Settings");
                        tip-keys: root.header-keys[14];
                        clicked => {
                            root.header-action("settings");
                        }
                    }
                }
            }

            HorizontalLayout {
                if root.sidebar-visible && root.chrome && root.page-count > 0: Sidebar {
                    thumbs: root.thumbs;
                    current-page: root.current-page - 1;
                    content-height: root.thumbs-content-height;
                    viewport-y <=> root.thumbs-viewport-y;
                    mode: root.side-panel;
                    panel-width: root.side-panel-width;
                    resized(width) => {
                        root.side-panel-resized(width);
                    }
                    items: root.side-items;
                    filters: root.note-filters;
                    all-label: root.notes-all-label;
                    progress-text: root.outline-progress-text;
                    reviewed-text: root.outline-reviewed-text;
                    progress: root.outline-progress;
                    mark-keys: root.header-keys[6];
                    export-keys: root.header-keys[7];
                    filter-clicked(i) => {
                        root.note-filter-clicked(i);
                    }
                    filter-all-clicked => {
                        root.note-filter-all();
                    }
                    status-clicked(i) => {
                        root.side-item-status-clicked(i);
                    }
                    clicked(page) => {
                        root.thumb-clicked(page);
                    }
                    mode-clicked(mode) => {
                        root.side-panel-clicked(mode);
                    }
                    item-clicked(i) => {
                        root.side-item-clicked(i);
                    }
                    export-clicked => {
                        root.header-action("export");
                    }
                    close-clicked => {
                        root.header-action("sidebar");
                    }
                }

                reader := Rectangle {
                    ReadingArea {
                        pages: root.pages;
                        content-width: root.content-width;
                        content-height: root.content-height;
                        viewport-x <=> root.viewport-x;
                        viewport-y <=> root.viewport-y;
                    }

                    // Text selection, annotation clicks, and Ctrl+wheel zoom.
                    // Plain wheel events fall through to the page strip.
                    if root.page-count > 0: TouchArea {
                        mouse-cursor: text;
                        pointer-event(event) => {
                            if event.button == PointerEventButton.left {
                                if event.kind == PointerEventKind.down {
                                    root.reader-pointer("down", self.mouse-x, self.mouse-y);
                                } else if event.kind == PointerEventKind.up {
                                    root.reader-pointer("up", self.mouse-x, self.mouse-y);
                                }
                            }
                            if event.kind == PointerEventKind.move && !self.pressed {
                                root.reader-pointer("hover", self.mouse-x, self.mouse-y);
                            }
                        }
                        moved => {
                            root.reader-pointer("move", self.mouse-x, self.mouse-y);
                        }
                        double-clicked => {
                            root.reader-pointer("double", self.mouse-x, self.mouse-y);
                        }
                        scroll-event(event) => {
                            if event.modifiers.control {
                                if event.delta-y != 0 {
                                    root.zoom-action(event.delta-y > 0 ? "in" : "out");
                                }
                                return accept;
                            }
                            reject
                        }
                    }

                    if root.page-count == 0 && root.library-view: LibraryScreen {
                        name: root.library-name;
                        icon: root.library-icon;
                        image: root.library-image;
                        has-image: root.library-has-image;
                        summary: root.library-summary;
                        books: root.library-books;
                        hero: root.library-hero;
                        query <=> root.library-query;
                        back => {
                            root.library-action("back", 0);
                        }
                        open-book(i) => {
                            root.library-action("open", i);
                        }
                        add-books => {
                            root.library-action("add", 0);
                        }
                        manage => {
                            root.library-action("manage", 0);
                        }
                        searched(text) => {
                            root.library-searched(text);
                        }
                    }

                    if root.page-count == 0 && !root.library-view: StartScreen {
                        recent: root.recent;
                        sessions: root.sessions;
                        session-name: root.session-name;
                        subjects: root.subjects;
                        study-summary: root.study-summary;
                        greeting: root.greeting;
                        open-keys: root.header-keys[12];
                        palette-keys: root.header-keys[5];
                        open-subject(i) => {
                            root.open-subject(i);
                        }
                        add => {
                            root.header-action("open");
                        }
                        libraries: root.libraries;
                        open-library(i) => {
                            root.open-library(i);
                        }
                        new-library => {
                            root.header-action("new-library");
                        }
                        open-recent(i) => {
                            root.open-recent(i);
                        }
                        open-session(i) => {
                            root.open-session(i);
                        }
                        new-session => {
                            root.header-action("new-session");
                        }
                    }

                    // Update available.
                    Panel {
                        visible: root.overlay == "update";
                        x: (parent.width - self.width) / 2;
                        y: parent.height * 0.2;
                        width: min(parent.width - 32px, 400px);
                        height: update-layout.preferred-height;

                        update-layout := VerticalLayout {
                            padding: 16px;
                            spacing: 10px;

                            Text {
                                text: @tr("Leme {} is available", root.update-version);
                                color: Theme.text;
                                font-size: Theme.font-size;
                                font-weight: 600;
                            }
                            Text {
                                text: root.update-installs ? @tr("Leme will close, update, and open again.") : @tr("This copy isn't installed, so the release page will open.");
                                color: Theme.text-muted;
                                font-size: Theme.font-size-small;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                alignment: end;
                                spacing: 6px;

                                QuietButton {
                                    text: @tr("Skip this version");
                                    clicked => {
                                        root.update-action("skip");
                                    }
                                }
                                QuietButton {
                                    text: @tr("Later");
                                    clicked => {
                                        root.update-action("later");
                                    }
                                }
                                QuietButton {
                                    text: root.update-installs ? @tr("Update") : @tr("Open page");
                                    primary: true;
                                    clicked => {
                                        root.update-action("install");
                                    }
                                }
                            }
                        }
                    }

                    // Name prompt (new or renamed session).
                    Panel {
                        visible: root.overlay == "prompt";
                        x: (parent.width - self.width) / 2;
                        y: parent.height * 0.2;
                        width: min(parent.width - 32px, 340px);
                        height: 44px;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;

                            Text {
                                text: root.prompt-label;
                                color: Theme.text-muted;
                                font-size: Theme.font-size;
                                vertical-alignment: center;
                            }
                            prompt-input := Field {
                                horizontal-stretch: 1;
                                input-type: root.prompt-secret ? InputType.password : InputType.text;
                                accepted => {
                                    root.prompt-accepted(self.text);
                                }
                            }
                        }
                    }

                    // Note tooltip, below the hovered annotation.
                    if root.note-tip != "" && root.popup == "": Panel {
                        width: min(360px, tip-text.preferred-width + 24px);
                        height: tip-text.preferred-height + 16px;
                        x: max(8px, min(parent.width - self.width - 8px, root.note-tip-x - self.width / 2));
                        y: min(parent.height - self.height - 8px, root.note-tip-y + 6px);
                        border-radius: Theme.radius + 2px;

                        tip-text := Text {
                            x: 12px;
                            y: 8px;
                            width: parent.width - 24px;
                            text: root.note-tip;
                            color: Theme.text;
                            font-size: Theme.font-size-small;
                            wrap: word-wrap;
                        }
                    }

                    // Selection toolbar, or the toolbar of a clicked annotation.
                    if root.popup != "": Panel {
                        x: max(8px, min(parent.width - self.width - 8px, root.popup-x - self.width / 2));
                        y: max(8px, root.popup-y - self.height - 8px);
                        width: popup-row.preferred-width;
                        height: 36px;
                        border-radius: Theme.radius + 2px;

                        popup-row := HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            spacing: 2px;

                            for c[i] in root.annotation-colors: Pigment {
                                y: (parent.height - self.height) / 2;
                                pigment: c;
                                number: i + 1;
                                clicked => {
                                    root.popup-action(root.popup == "selection" ? "highlight" : "color", i);
                                }
                            }
                            Rectangle {
                                width: 9px;

                                Rectangle {
                                    width: 1px;
                                    height: 16px;
                                    background: Theme.border;
                                }
                            }
                            QuietButton {
                                y: (parent.height - self.height) / 2;
                                text: "U̲";
                                strong: true;
                                clicked => {
                                    root.popup-action("underline", 0);
                                }
                            }
                            QuietButton {
                                y: (parent.height - self.height) / 2;
                                text: "S̶";
                                strong: true;
                                clicked => {
                                    root.popup-action("strike", 0);
                                }
                            }
                            QuietButton {
                                y: (parent.height - self.height) / 2;
                                text: root.popup == "annotation" && root.annotation-has-note ? @tr("Edit note") : @tr("Note");
                                keys: root.header-keys[8];
                                strong: true;
                                clicked => {
                                    root.popup-action("note", 0);
                                }
                            }
                            QuietButton {
                                y: (parent.height - self.height) / 2;
                                text: @tr("Copy");
                                keys: root.header-keys[9];
                                strong: true;
                                clicked => {
                                    root.popup-action("copy", 0);
                                }
                            }
                            if root.popup == "annotation": QuietButton {
                                y: (parent.height - self.height) / 2;
                                text: @tr("Delete");
                                strong: true;
                                clicked => {
                                    root.popup-action("delete", 0);
                                }
                            }
                        }
                    }

                    // Search: a panel top right; across every tab, it lists
                    // the pages found, grouped by document.
                    Panel {
                        visible: root.overlay == "search";
                        x: parent.width - self.width - 12px;
                        y: 12px;
                        width: min(parent.width - 24px, 400px);
                        height: search-layout.preferred-height;

                        // Clicks on the panel don't start a text selection.
                        TouchArea { }

                        search-layout := VerticalLayout {
                            FocusScope {
                                height: 44px;

                                // Enter / Shift+Enter step through matches.
                                capture-key-pressed(event) => {
                                    if event.text == Key.Return {
                                        root.search-step(!event.modifiers.shift);
                                        return accept;
                                    }
                                    reject
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 8px;
                                    spacing: 4px;

                                    Icon {
                                        y: (parent.height - self.height) / 2;
                                        name: "search";
                                    }
                                    Rectangle {
                                        width: 4px;
                                    }
                                    search-input := Field {
                                        horizontal-stretch: 1;
                                        edited => {
                                            root.search-edited(self.text);
                                        }
                                    }
                                    Text {
                                        text: root.search-status;
                                        color: Theme.text-muted;
                                        font-size: Theme.font-size-small;
                                        vertical-alignment: center;
                                    }
                                    QuietButton {
                                        y: (parent.height - self.height) / 2;
                                        icon: "up";
                                        clicked => {
                                            root.search-step(false);
                                        }
                                    }
                                    QuietButton {
                                        y: (parent.height - self.height) / 2;
                                        icon: "down";
                                        clicked => {
                                            root.search-step(true);
                                        }
                                    }
                                    QuietButton {
                                        y: (parent.height - self.height) / 2;
                                        icon: "close";
                                        clicked => {
                                            root.overlay-dismissed();
                                        }
                                    }
                                }

                                if search-input.text == "": Text {
                                    x: 38px;
                                    text: @tr("Search");
                                    color: Theme.text-muted;
                                    font-size: Theme.font-size;
                                }
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-bottom: 8px;
                                spacing: 4px;
                                alignment: start;

                                QuietButton {
                                    text: @tr("This document");
                                    keys: root.header-keys[10];
                                    selected: root.search-scope == "document";
                                    clicked => {
                                        root.search-scope-clicked("document");
                                    }
                                }
                                QuietButton {
                                    text: @tr("All tabs");
                                    keys: root.header-keys[11];
                                    selected: root.search-scope == "session";
                                    clicked => {
                                        root.search-scope-clicked("session");
                                    }
                                }
                            }

                            if root.search-scope == "session" && root.search-hits.length > 0: Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }
                            if root.search-scope == "session" && root.search-hits.length > 0: Flickable {
                                height: min(hits.preferred-height, max(120px, reader.height - 190px));
                                content-width: self.width;
                                content-height: hits.preferred-height;

                                hits := VerticalLayout {
                                    width: parent.width;
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    padding-bottom: 6px;
                                    alignment: start;

                                    for hit[i] in root.search-hits: Rectangle {
                                        height: 30px;
                                        border-radius: max(0px, Theme.radius - 1px);
                                        background: hit.header ? transparent : hit.current ? Theme.surface : hit-touch.has-hover ? Theme.hover : transparent;

                                        hit-touch := TouchArea {
                                            enabled: !hit.header;
                                            mouse-cursor: hit.header ? default : pointer;
                                            clicked => {
                                                root.search-hit-clicked(i);
                                            }
                                        }

                                        if hit.header: HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            padding-top: 8px;
                                            spacing: 8px;

                                            Label {
                                                label: hit.title;
                                                horizontal-stretch: 1;
                                            }
                                            Label {
                                                label: hit.page;
                                            }
                                        }
                                        if !hit.header: HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 10px;

                                            Text {
                                                width: 48px;
                                                text: hit.page;
                                                color: hit.current ? Theme.accent : Theme.text-muted;
                                                font-size: Theme.font-size-ui;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: hit.title;
                                                color: hit.current ? Theme.text : Theme.text-muted;
                                                font-size: Theme.font-size-ui;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }
                            HorizontalLayout {
                                padding: 8px;
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 14px;

                                Hint {
                                    keys: "Enter";
                                    text: @tr("next");
                                }
                                Hint {
                                    keys: "Shift Enter";
                                    text: @tr("previous");
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                                Hint {
                                    keys: "Esc";
                                    text: @tr("close");
                                }
                            }
                        }
                    }

                    // Jump to page: centered near the top.
                    Panel {
                        visible: root.overlay == "goto";
                        x: (parent.width - self.width) / 2;
                        y: parent.height * 0.2;
                        width: min(parent.width - 32px, 280px);
                        height: 44px;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;

                            Text {
                                text: @tr("Page or art.");
                                color: Theme.text-muted;
                                font-size: Theme.font-size;
                                vertical-alignment: center;
                            }
                            goto-input := Field {
                                horizontal-stretch: 1;
                                accepted => {
                                    root.goto-accepted(self.text);
                                }
                            }
                            Text {
                                text: "/ \{root.page-count}";
                                color: Theme.text-muted;
                                font-size: Theme.font-size;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // The palette, the note editor, and the export sheet take over:
        // the document dims behind them.
        if root.modal: Scrim {
            dismissed => {
                root.overlay-dismissed();
            }
        }

        // Export notes: format, colors, and a preview of the file.
        Panel {
            visible: root.overlay == "export";
            x: (parent.width - self.width) / 2;
            y: max(16px, parent.height * 0.14);
            width: min(parent.width - 32px, 560px);
            height: export-layout.preferred-height;

            TouchArea { }

            export-keys := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Return {
                        root.export-accepted();
                        return accept;
                    }
                    reject
                }

                export-layout := VerticalLayout {
                    padding: 18px;
                    spacing: 14px;

                    HorizontalLayout {
                        Text {
                            text: @tr("Export notes");
                            color: Theme.text;
                            font-size: Theme.font-size-large;
                            font-weight: 600;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.export-count;
                            color: Theme.text-muted;
                            font-size: Theme.font-size-small;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        for f in [
                            { id: "markdown", label: "Markdown", detail: @tr("summary by section") },
                            { id: "anki", label: "Anki", detail: @tr("front · back · tags") },
                            { id: "csv", label: "CSV", detail: @tr("any app") },
                        ]: Rectangle {
                            height: 52px;
                            horizontal-stretch: 1;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: root.export-format == f.id ? Theme.accent : Theme.border;
                            background: format-touch.has-hover ? Theme.hover : transparent;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: f.label;
                                    color: Theme.text;
                                    font-size: Theme.font-size;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: f.detail;
                                    color: Theme.text-muted;
                                    font-size: Theme.font-size-small;
                                    horizontal-alignment: center;
                                }
                            }

                            format-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.export-option("format", f.id);
                                }
                            }
                        }
                    }

                    // The notes filter's colors; the export follows them.
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        for c[i] in root.note-filters: Rectangle {
                            height: 24px;
                            width: chip-row.preferred-width + 16px;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: c.on ? Theme.text-muted : Theme.border;
                            opacity: c.on ? 1 : 0.5;

                            chip-row := HorizontalLayout {
                                x: 8px;
                                spacing: 6px;

                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: c.color;
                                }
                                Text {
                                    text: c.name;
                                    color: Theme.text;
                                    font-size: Theme.font-size-small;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.note-filter-clicked(i);
                                }
                            }
                        }
                    }

                    if root.export-format == "markdown": HorizontalLayout {
                        spacing: 10px;

                        Toggle {
                            checked: root.export-by-section;
                            toggled => {
                                root.export-option("by-section", root.export-by-section ? "false" : "true");
                            }
                        }
                        Text {
                            text: @tr("Group by outline section and color");
                            color: Theme.text;
                            font-size: Theme.font-size-small;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }

                    Rectangle {
                        height: 180px;
                        border-radius: Theme.radius;
                        background: Theme.surface;
                        clip: true;

                        Text {
                            x: 12px;
                            y: 10px;
                            width: parent.width - 24px;
                            text: root.export-ready ? root.export-preview : @tr("No notes in the chosen colors");
                            color: Theme.text-muted;
                            font-family: "Cascadia Mono, Consolas";
                            font-size: Theme.font-size-small;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                    }

                    HorizontalLayout {
                        Text {
                            text: root.export-format == "anki" ? @tr("In Anki: File › Import. The note becomes the front, the quote the back.") : @tr("Enter to save · Esc to close");
                            color: Theme.text-muted;
                            font-size: Theme.font-size-small;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        Button {
                            text: @tr("Save…");
                            primary: true;
                            clicked => {
                                root.export-accepted();
                            }
                        }
                    }
                }
            }
        }

        // Note editor: the color and what it means, the quote, the note.
        Panel {
            visible: root.overlay == "note";
            x: (parent.width - self.width) / 2;
            y: max(16px, parent.height * 0.22);
            width: min(parent.width - 32px, 480px);
            height: note-layout.preferred-height;

            TouchArea { }

            FocusScope {
                capture-key-pressed(event) => {
                    if event.text == Key.Return && event.modifiers.control {
                        root.note-saved();
                        return accept;
                    }
                    reject
                }

                note-layout := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 4px;

                        for c[i] in root.annotation-colors: Pigment {
                            pigment: c;
                            number: i + 1;
                            chosen: i == root.note-color;
                            clicked => {
                                root.note-color-clicked(i);
                            }
                        }
                        Rectangle {
                            width: 4px;
                        }
                        Text {
                            text: root.note-color-name;
                            color: Theme.text;
                            font-size: Theme.font-size-ui;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.note-page;
                            color: Theme.text-muted;
                            font-size: Theme.font-size-small;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "“" + root.note-quote + "”";
                        color: Theme.text-muted;
                        font-size: Theme.font-size;
                        font-italic: true;
                        wrap: word-wrap;
                        overflow: elide;
                        max-height: 64px;
                    }
                    Rectangle {
                        height: 96px;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: note-input.has-focus ? Theme.accent : Theme.border;
                        background: Theme.surface;

                        note-input := TextInput {
                            x: 12px;
                            y: 10px;
                            width: parent.width - 24px;
                            height: parent.height - 20px;
                            color: Theme.text;
                            font-size: Theme.font-size;
                            selection-background-color: Theme.selection;
                            wrap: word-wrap;
                            single-line: false;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;

                        if root.note-exists: QuietButton {
                            text: @tr("Delete note");
                            font-size: Theme.font-size-small;
                            clicked => {
                                root.note-deleted();
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        QuietButton {
                            text: @tr("Cancel");
                            keys: "Esc";
                            clicked => {
                                root.overlay-dismissed();
                            }
                        }
                        QuietButton {
                            text: @tr("Save");
                            keys: "Ctrl Enter";
                            primary: true;
                            clicked => {
                                root.note-saved();
                            }
                        }
                    }
                }
            }
        }

        // Command palette, near the top like Zed and VS Code.
        palette := Palette {
            visible: root.overlay == "palette";
            x: (parent.width - self.width) / 2;
            y: max(16px, min(112px, parent.height * 0.14));
            width: min(parent.width - 32px, 640px);
            items: root.palette-items;
            selected: root.palette-selected;
            placeholder: root.palette-placeholder;
            edited(text) => {
                root.palette-edited(text);
            }
            moved(delta) => {
                root.palette-moved(delta);
            }
            accepted => {
                root.palette-accepted();
            }
            item-clicked(i) => {
                root.palette-clicked(i);
            }
        }

        // Notification: "Downloading Leme…", "Copied". Quick ones clear
        // themselves from Rust; the rest stay until done or dismissed.
        if root.status != "": Panel {
            x: parent.width - self.width - Theme.spacing;
            y: parent.height - self.height - Theme.spacing;
            width: min(parent.width - 2 * Theme.spacing, 340px);
            height: toast-row.preferred-height;
            border-radius: Theme.radius + 2px;

            toast-row := HorizontalLayout {
                padding: 10px;
                padding-left: 12px;
                spacing: 10px;

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.accent;
                }
                Text {
                    text: root.status;
                    color: Theme.text;
                    font-size: Theme.font-size-ui;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                QuietButton {
                    y: (parent.height - self.height) / 2;
                    height: 22px;
                    icon: "close";
                    icon-size: 12px;
                    clicked => {
                        root.status = "";
                    }
                }
            }
        }
    }
}

// Settings live in their own window, so they can sit beside the document.
export component SettingsWindow inherits Window {
    title: @tr("Leme settings");
    icon: @image-url("../../../assets/icon.svg");
    preferred-width: 1000px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 420px;
    background: Theme.background;
    default-font-family: Theme.font-family;

    in-out property <string> section: "general";
    in property <[ThemeCard]> theme-cards;
    in property <[string]> other-themes;
    in property <string> other-theme;
    in property <string> theme-name;
    in property <string> page-colors;
    in property <[string]> font-options;
    in property <string> font-name;
    in property <int> font-size;
    in property <string> density;
    in property <string> corners;
    in property <string> thumbnail-size;
    in property <string> default-zoom;
    in property <bool> restore-session;
    in property <bool> sidebar-default;
    in property <bool> vim;
    in property <bool> study-timer;
    in property <[KeyRow]> key-rows;
    in property <[HighlightRow]> highlight-rows;
    in property <string> language;
    in property <[string]> language-options;
    in property <[color]> highlight-presets;
    in property <string> data-dir;
    in property <string> problems;
    in property <string> version;
    in-out property <string> query;
    in property <bool> show-general: true;
    in property <bool> show-reading: true;
    in property <bool> show-theme: true;
    in property <bool> show-appearance: true;
    in property <bool> show-keys: true;
    in property <bool> show-files: true;
    in property <bool> show-libraries: true;
    in property <[LibraryRow]> library-rows;
    in property <[string]> library-icons;
    in property <[string]> library-icon-keys;
    callback set(string, string);
    callback searched(string);
    callback close-requested();

    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-requested();
                return accept;
            }
            reject
        }

        SettingsView {
            section <=> root.section;
            query <=> root.query;
            theme-cards: root.theme-cards;
            other-themes: root.other-themes;
            other-theme: root.other-theme;
            show-general: root.show-general;
            show-reading: root.show-reading;
            show-theme: root.show-theme;
            show-appearance: root.show-appearance;
            show-keys: root.show-keys;
            show-files: root.show-files;
            show-libraries: root.show-libraries;
            library-rows: root.library-rows;
            library-icons: root.library-icons;
            library-icon-keys: root.library-icon-keys;
            theme: root.theme-name;
            page-colors: root.page-colors;
            font-options: root.font-options;
            font-name: root.font-name;
            font-size: root.font-size;
            density: root.density;
            corners: root.corners;
            thumbnail-size: root.thumbnail-size;
            default-zoom: root.default-zoom;
            restore-session: root.restore-session;
            sidebar: root.sidebar-default;
            vim: root.vim;
            study-timer: root.study-timer;
            keys: root.key-rows;
            highlights: root.highlight-rows;
            language: root.language;
            language-options: root.language-options;
            presets: root.highlight-presets;
            data-dir: root.data-dir;
            problems: root.problems;
            version: root.version;
            set(key, value) => {
                root.set(key, value);
            }
            searched(text) => {
                root.searched(text);
            }
            close => {
                root.close-requested();
            }
        }
    }
}
